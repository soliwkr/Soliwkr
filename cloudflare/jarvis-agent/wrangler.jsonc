{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soliwkr-jarvis-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JarvisAgent",
        "class_name": "JarvisAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "JarvisAgent"
      ]
    }
  ],
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": false
    }
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_BOT_USERNAME",
      "TELEGRAM_WEBHOOK_SECRET_TOKEN",
      "JARVIS_OWNER_TELEGRAM_ID"
    ]
  }
}

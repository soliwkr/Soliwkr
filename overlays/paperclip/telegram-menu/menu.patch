@@ -0,0 +1,90 @@
+import { createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+import { and, asc, eq, inArray } from "drizzle-orm";
+import { agents, approvals, issues, projects, type Db } from "@paperclipai/db";
+import { Actions, Button, Card, CardText } from "chat";
+import { projectSafeChatPublication, type ChatPublicationProjectionInput } from "../../chat-publication-projection.js";
+
+// Process-local capability: restart invalidates old navigation. No persistent
+// secret, receiver, timer, cache, webhook or provider configuration is added.
+const key = randomBytes(32);
+const sections = ["home", "today", "decisions", "portfolio", "experiments", "agents", "economy", "alerts", "ceo"] as const;
+const labels = ["Menu", "🎯 Task aperte", "📥 Decisioni", "📁 Portafoglio", "🧪 Esperimenti", "🤖 Agenti", "💰 Economia", "🔔 Alert", "💬 Parla col CEO"];
+const PAGE = 5;
+// Deployment-specific board origin, never derived from callback or database text.
+const BOARD = "https://hq.soliwkr.pro/SOL";
+const short = (value: string) => value.replace(/[\r\n\t]+/g, " ").slice(0, 100);
+const decisionLabel = (kind: string) => (({ hire_agent: "Assunzione agente", approve_ceo_strategy: "Strategia CEO" } as Record<string, string>)[kind] || short(kind.replaceAll("_", " ")));
+const boardLink = (kind: "issues" | "approvals", id: string) => `${BOARD}/${kind}/${encodeURIComponent(id)}`;
+type Scope = { endpointId: string; userId: string; threadId: string };
+export type MenuRoute = { section: string; page: number };
+export type TelegramMenu = NonNullable<ChatPublicationProjectionInput["interaction"]>;
+const validSection = (s: string) => sections.includes(s as typeof sections[number]) || /^p[a-f0-9]{32}$/.test(s);
+export function menuRoute(text: string): MenuRoute | null {
+  const match = /^\/(?:menu|start)(?:@[\w.-]+)?(?:\s|$)/i.exec(text.trim());
+  if (!match) return null;
+  const [section = "home", rawPage = "0"] = text.trim().slice(match[0].length).trim().split(/\s+/);
+  const page = Number(rawPage);
+  return validSection(section) && Number.isInteger(page) && page >= 0 && page <= 999
+    ? { section, page } : { section: "home", page: 0 };
+}
+export function menuToken(route: MenuRoute, scope: Scope, now = Date.now()): string {
+  if (!validSection(route.section) || !Number.isInteger(route.page) || route.page < 0 || route.page > 999) throw new Error("Invalid menu route");
+  const data = `m.${route.section}.${route.page.toString(36)}.${(Math.floor(now / 1000) + 600).toString(36)}`;
+  const signature = createHmac("sha256", key).update(JSON.stringify([scope.endpointId, scope.userId, scope.threadId, data])).digest("base64url").slice(0, 14);
+  return `${data}.${signature}`;
+}
+export function verifyMenuToken(token: string, scope: Scope, now = Date.now()): MenuRoute | null {
+  if (token.length > 64) return null;
+  const match = /^m\.([a-z0-9]+)\.([0-9a-z]{1,2})\.([0-9a-z]{6,8})\.([A-Za-z0-9_-]{14})$/.exec(token);
+  if (!match || !validSection(match[1])) return null;
+  const page = parseInt(match[2], 36), expires = parseInt(match[3], 36);
+  const seconds = Math.floor(now / 1000);
+  if (page > 999 || expires <= seconds || expires > seconds + 600) return null;
+  const data = token.slice(0, token.lastIndexOf("."));
+  const expected = createHmac("sha256", key).update(JSON.stringify([scope.endpointId, scope.userId, scope.threadId, data])).digest("base64url").slice(0, 14);
+  return timingSafeEqual(Buffer.from(expected), Buffer.from(match[4])) ? { section: match[1], page } : null;
+}
+export function renderTelegramMenu(menu: TelegramMenu) {
+  const safe = projectSafeChatPublication({ classification: "external", source: "task_control", text: menu.card.body || menu.card.title, interaction: menu });
+  return Card({ title: safe.card!.title, children: [CardText(safe.card!.body || safe.text), ...(safe.card!.actions || []).map(action => Actions([action.type === "callback" ? Button({ id: action.actionId, label: action.label }) : (() => { throw new Error("Menu only supports navigation callbacks"); })()]))] });
+}
+export async function readTelegramMenu(db: Db, companyId: string, route: MenuRoute, scope: Scope): Promise<TelegramMenu> {
+  const actions: { type: "callback"; actionId: string; label: string }[] = [];
+  const add = (label: string, section: string, page = 0) => actions.push({ type: "callback", label, actionId: menuToken({ section, page }, scope) });
+  const name = labels[sections.indexOf(route.section as typeof sections[number])] || "Progetto";
+  let body = `SOLIWKR / ${name}\nFonte: Paperclip; lettura ${new Date().toISOString()}\n`;
+  let hasNext = false;
+  const start = route.page * PAGE;
+  if (route.section === "home") {
+    body += "Navigazione in sola lettura. Nessun tap concede un GO. Le conferme native restano separate.";
+    sections.slice(1).forEach((section, index) => add(labels[index + 1], section));
+  } else if (route.section === "ceo") {
+    body += "Scrivi un messaggio libero per parlare con il CEO. La chat e le conferme native continuano come prima.";
+  } else if (route.section === "economy" || route.section === "experiments") {
+    body += route.section === "economy" ? "NOT IMPLEMENTED — UNKNOWN: fonte economica proof-backed non collegata. Nessuna cifra stimata." : "NOT IMPLEMENTED — UNKNOWN: registro esperimenti BLACK OFFICE non collegato. Paperclip non sostituisce la fonte owner.";
+  } else if (route.section === "portfolio") {
+    const rows = await db.select({ id: projects.id, name: projects.name, status: projects.status }).from(projects).where(eq(projects.companyId, companyId)).orderBy(asc(projects.id)).limit(PAGE + 1).offset(start);
+    hasNext = rows.length > PAGE;
+    body += "Progetti Paperclip; verdict owner TENERE/CONGELARE/ARCHIVIARE/APERTI: NOT IMPLEMENTED. Dettagli task nella navigazione; prove nella board protetta.\n";
+    rows.slice(0, PAGE).forEach(row => { body += `${short(row.name)} — ${row.status}\n`; add(short(row.name).slice(0, 40), `p${row.id.replaceAll("-", "")}`); });
+    if (!rows.length) body += "Nessun progetto visibile.";
+  } else if (route.section === "agents") {
+    const rows = await db.select({ name: agents.name, status: agents.status }).from(agents).where(eq(agents.companyId, companyId)).orderBy(asc(agents.id)).limit(PAGE + 1).offset(start);
+    hasNext = rows.length > PAGE;
+    body += rows.slice(0, PAGE).map(row => `${short(row.name)} — ${row.status}`).join("\n") || "Nessun agente.";
+  } else if (route.section === "decisions") {
+    const rows = await db.select({ id: approvals.id, type: approvals.type, status: approvals.status }).from(approvals).where(and(eq(approvals.companyId, companyId), eq(approvals.status, "pending"))).orderBy(asc(approvals.id)).limit(PAGE + 1).offset(start);
+    hasNext = rows.length > PAGE;
+    body += rows.slice(0, PAGE).map(row => `${decisionLabel(row.type)} — ${row.status}\n[Apri decisione protetta](${boardLink("approvals", row.id)})`).join("\n") || "Nessuna approvazione pending. Le questioni sulle task restano nelle conferme native.";
+    body += "\nApri Paperclip per prove e decisioni protette. Questo menu non approva né rifiuta.";
+  } else {
+    const project = route.section.startsWith("p") && /^p[a-f0-9]{32}$/.test(route.section) ? route.section.slice(1).replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/, "$1-$2-$3-$4-$5") : null;
+    const rows = await db.select({ identifier: issues.identifier, title: issues.title, status: issues.status }).from(issues).where(and(eq(issues.companyId, companyId), eq(issues.visibility, "open"), project ? eq(issues.projectId, project) : inArray(issues.status, route.section === "alerts" ? ["blocked"] : ["todo", "in_progress"]))).orderBy(asc(issues.id)).limit(PAGE + 1).offset(start);
+    hasNext = rows.length > PAGE;
+    body += "Metadati task aperte (non una priorità ONE NEXT approvata):\n" + (rows.slice(0, PAGE).map(row => `${row.identifier || "Task"} — ${short(row.title)} — ${row.status}${row.identifier ? "\n[Apri task e prove](" + boardLink("issues", row.identifier) + ")" : ""}`).join("\n") || "Nessuna task.");
+  }
+  if (route.page > 0) add("◀ Pagina", route.section, route.page - 1);
+  if (hasNext && route.page < 999) add("Pagina ▶", route.section, route.page + 1);
+  if (route.section !== "home") { add("↩ Indietro", route.section.startsWith("p") && route.section !== "portfolio" ? "portfolio" : "home"); add("🔄 Aggiorna", route.section, route.page); }
+  return { id: "telegram-menu", card: { kind: "status", title: name, body, actions } };
+}

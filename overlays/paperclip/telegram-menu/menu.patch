+import { describe, it, expect } from "vitest";
+import { menuRoute, menuToken, verifyMenuToken, readTelegramMenu, renderTelegramMenu } from "../services/chat-channels/telegram/menu.js";
+const scope = { endpointId: "endpoint", userId: "owner", threadId: "telegram:owner" };
+describe("CEO read-only menu", () => {
+  it("reserves only menu/start and preserves free chat", () => {
+    expect(menuRoute("hello CEO")).toBeNull();
+    expect(menuRoute("/task build")).toBeNull();
+    expect(menuRoute("/start")).toEqual({section:"home",page:0});
+    expect(menuRoute("/menu portfolio 2")).toEqual({section:"portfolio",page:2});
+  });
+  it("rejects forged, expired and cross-principal capabilities", () => {
+    const now=1800000000000, token=menuToken({section:"portfolio",page:0},scope,now);
+    expect(verifyMenuToken(token,scope,now)).toEqual({section:"portfolio",page:0});
+    expect(verifyMenuToken(token,scope,now+600000)).toBeNull();
+    expect(verifyMenuToken(token.slice(0,-1)+"!",scope,now)).toBeNull();
+    for(const field of ["endpointId","userId","threadId"]) expect(verifyMenuToken(token,{...scope,[field]:"other"},now)).toBeNull();
+    expect(Buffer.byteLength(menuToken({section:"p"+"a".repeat(32),page:999},scope,now))).toBeLessThanOrEqual(64);
+  });
+  it("renders eight scoped navigation buttons without writes", async () => {
+    const db = new Proxy({}, {get(){throw new Error("Home must not access database");}}) as never;
+    const menu=await readTelegramMenu(db,"company",{section:"home",page:0},scope);
+    expect(menu.card.actions).toHaveLength(8);
+    for(const action of menu.card.actions!) {
+      expect(action.type).toBe("callback");
+      if(action.type==="callback") expect(verifyMenuToken(action.actionId,scope)).not.toBeNull();
+    }
+    expect(renderTelegramMenu(menu)).toBeTruthy();
+  });
+  it("marks missing owner sources explicitly", async () => {
+    for(const section of ["economy","experiments"]) {
+      const menu=await readTelegramMenu({} as never,"company",{section,page:0},scope);
+      expect(menu.card.body).toContain("NOT IMPLEMENTED");
+      expect(menu.card.actions!.map(a=>a.label)).toEqual(["↩ Indietro","🔄 Aggiorna"]);
+    }
+  });
+  it("shows names, short task titles and protected decision links without raw ID labels", async () => {
+    const id = "12345678-1234-1234-1234-123456789abc";
+    const fixture = (rows: object[]) => {
+      const query: any = {};
+      for (const step of ["from", "where", "orderBy", "limit"]) query[step] = () => query;
+      query.offset = async () => rows;
+      return { select: () => query } as never;
+    };
+    const project = await readTelegramMenu(fixture([{id, name:"RankEmpire", status:"in_progress"}]), "company", {section:"portfolio",page:0}, scope);
+    expect(project.card.body).toContain("RankEmpire — in_progress");
+    expect(project.card.actions![0].label).toBe("RankEmpire");
+    expect(project.card.body).not.toContain(id);
+    const agent = await readTelegramMenu(fixture([{name:"CEO",status:"idle"}]), "company", {section:"agents",page:0}, scope);
+    expect(agent.card.body).toContain("CEO — idle");
+    const task = await readTelegramMenu(fixture([{identifier:"SOL-34",title:"Verifica prove",status:"blocked"}]), "company", {section:"alerts",page:0}, scope);
+    expect(task.card.body).toContain("SOL-34 — Verifica prove — blocked");
+    expect(task.card.body).toContain("https://hq.soliwkr.pro/SOL/issues/SOL-34");
+    const decision = await readTelegramMenu(fixture([{id,type:"hire_agent",status:"pending"}]), "company", {section:"decisions",page:0}, scope);
+    expect(decision.card.body).toContain("Assunzione agente — pending");
+    expect(decision.card.body).toContain("https://hq.soliwkr.pro/SOL/approvals/" + id);
+    expect(renderTelegramMenu(decision)).toBeTruthy();
+    const home = await readTelegramMenu({} as never,"company",{section:"home",page:0},scope);
+    expect(home.card.actions![0].label).toBe("🎯 Task aperte");
+  });
+
+});
